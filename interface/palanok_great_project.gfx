# Palanok, the castle above Mukachevo. The game logged 317 times that
# GFX_great_project_palanok_fortress was missing, so the province view had
# nothing to draw for the monument.
#
# The art is a photograph of the castle worked into the shape vanilla uses.
# Vanilla monument art is 300x150, painted, and measured over six of them it
# sits at mean saturation 80/255, value 125/255 and luminance spread 62. The
# photograph was cropped to 2:1 on the castle, flattened with two median
# passes so the detail reads as brushwork rather than grain, graded onto those
# three numbers, then given the aerial haze the paintings use to push distance
# back - which is what carries the modern town behind the walls into pale blue.
# The 5px gilt border and the translucent name plaque are baked into every
# vanilla monument texture, so both are reproduced here: the border copied,
# the plaque as the measured multiply of 0.47 / 0.53 / 0.57.
#
# It remains a photograph of an aerial view, where the vanilla set is painted
# at eye level against sky. Worth replacing if drawn art ever appears.

spriteTypes = {
	spriteType = {
		name = "GFX_great_project_palanok_fortress"
		texturefile = "gfx//interface//great_projects//great_project_palanok_fortress.dds"
	}
}
