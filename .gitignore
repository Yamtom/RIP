
# Build and diagnostic archives
*.zip

# Local tooling and caches
.claude/*
# ...except the skill: git will not descend into an excluded directory, so the
# contents are excluded and the skill added back
!.claude/skills/
.cpatch/
.pytest_cache/
.venv/
.vscode/
__pycache__/
*.py[cod]

# Editor and operating-system files
.DS_Store
Thumbs.db
*.tmp

# Asset backups are not game content
*.bak

# A mod repository must never contain a second Git repository.
RIP-fresh2/

# EU4 run artefacts: load tests and observer runs drop logs, crash folders and
# memory dumps here, several hundred megabytes at a time. The tooling that
# produces them lives in tests/observer and is tracked; its output is not.
# diagnostics/parser_recovery_20260219_195115 predates this rule and stays.
/diagnostics/*_load_*/
/diagnostics/*_smoke_*/
/diagnostics/observer_runs/**
# ...except the run manifests, which are the evidence BALANCE_PLAYTEST_REPORT
# links to. 12 of them, 1.7 MB, against 275 MB of logs and dumps beside them.
!/diagnostics/observer_runs/**/
!/diagnostics/observer_runs/**/manifest.json
# The un-ignore of directories above would otherwise expose source_snapshot,
# which copies the whole tree including .claude/worktrees - and a worktree
# carries a .git file, which git records as a submodule gitlink. README
# forbids nested repositories; this keeps them out.
/diagnostics/**/source_snapshot/
/diagnostics/*.mod
/diagnostics/dlc_load_baseline_*.json

2481053190/
