# Religion frames 30/31/32: Russian Orthodox, Greek Catholic, Old Believers.
# Four strips and five sprite declarations retain native 64px/32px geometry.
# Frames 1-29 preserve installed vanilla pixels. New frames use transparent
# painted PNG masters in gfx/interface/religion_icons/source.
# Muted pewter, rose and sage tones are gameplay design distinctions.
# Generated by tools/build_religion_icon_strips.py, including standalone DDS.
# Ledger path/transparencecheck and province loadType follow vanilla.

spriteTypes = {

	spriteType = {
		name = "GFX_icon_religion"
		texturefile = "gfx//interface//icon_religion.dds"
		noOfFrames = 32
	}

	spriteType = {
		name = "GFX_country_icon_religion"
		texturefile = "gfx//interface//country_icon_religion.dds"
		noOfFrames = 32
	}

	spriteType = {
		name = "GFX_icon_religion_small"
		texturefile = "gfx//interface//icon_religion_small.dds"
		noOfFrames = 32
	}

	spriteType = {
		name = "GFX_province_view_religion"
		texturefile = "gfx//interface//province_view_religion.dds"
		noOfFrames = 32
		loadType = "INGAME"
	}

	spriteType = {
		name = "GFX_religion_icon_strip"
		texturefile = "gfx\\interface\\icon_religion_small.dds"
		transparencecheck = yes
		noOfFrames = 32
	}
}
